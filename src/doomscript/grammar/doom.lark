// DoomScript Formal EBNF Grammar (Lark)

start: (_NEWLINE | stmt)*

?stmt: simple_stmt _NEWLINE
     | compound_stmt

?simple_stmt: base_simple_stmt
            | base_simple_stmt "if" expr -> post_if
            | base_simple_stmt "unless" expr -> post_unless

?base_simple_stmt: say_stmt
                 | assign_stmt
                 | aug_assign_stmt
                 | set_stmt
                 | increase_stmt
                 | decrease_stmt
                 | ask_stmt
                 | ask_choice_stmt
                 | ask_number_stmt
                 | ask_bool_stmt
                 | read_csv_stmt
                 | write_csv_stmt
                 | append_csv_stmt
                 | json_parse_stmt
                 | json_stringify_stmt
                 | env_var_stmt
                 | run_cmd_stmt
                 | insert_stmt
                 | sort_stmt
                 | reverse_stmt
                 | group_stmt
                 | filter_stmt
                 | comp_assign_stmt
                 | use_py_stmt
                 | from_py_stmt
                 | use_doom_stmt
                 | skip_stmt
                 | write_file_stmt
                 | append_file_stmt
                 | read_file_stmt
                 | copy_file_stmt
                 | delete_file_stmt
                 | create_dir_stmt
                 | list_files_stmt
                 | check_file_stmt
                 | string_upper_stmt
                 | string_lower_stmt
                 | spawn_stmt
                 | wait_thread_stmt
                 | route_stmt
                 | start_server_stmt
                 | stop_server_stmt
                 | display_colored_stmt
                 | pause_stmt
                 | math_round_stmt
                 | math_clamp_stmt
                 | verify_stmt
                 | fetch_json_stmt
                 | fetch_text_stmt
                 | download_file_stmt
                 | random_roll_stmt
                 | pick_random_stmt
                 | shuffle_stmt
                 | db_save_stmt
                 | db_load_stmt
                 | beep_stmt
                 | play_sound_stmt
                 | open_window_stmt
                 | draw_circle_stmt
                 | draw_rect_stmt
                 | draw_text_stmt
                 | clear_screen_stmt
                 | refresh_screen_stmt
                 | add_stmt
                 | remove_stmt
                 | wait_stmt
                 | return_stmt
                 | yield_stmt
                 | stop_stmt
                 | call_stmt
                 | expr_stmt
                 | global_stmt

say_stmt: "say" expr ("," expr)* -> say_multi
assign_stmt: target_list "=" expr_list -> assign
aug_assign_stmt: target "+=" expr -> aug_add
               | target "-=" expr -> aug_sub
               | target "*=" expr -> aug_mul
               | target "/=" expr -> aug_div
               | target "//=" expr -> aug_floor_div
               | target "%=" expr -> aug_mod

target_list: target ("," target)* [","]
expr_list: expr ("," expr)* [","]
set_stmt: "set" target "to" expr -> set_var
increase_stmt: "increase" target "by" expr -> increase_var
decrease_stmt: "decrease" target "by" expr -> decrease_var
ask_stmt: "ask" expr "into" target -> ask_input
ask_choice_stmt: "ask" "choice" expr "from" expr "into" target -> ask_choice
ask_number_stmt: "ask" "number" expr "into" target -> ask_number
ask_bool_stmt: "ask" "boolean" expr "into" target -> ask_boolean
read_csv_stmt: "read" "csv" "file" expr "into" target -> read_csv
write_csv_stmt: "write" "csv" expr "into" "file" expr -> write_csv
append_csv_stmt: "append" "csv" expr "to" "file" expr -> append_csv
json_parse_stmt: "parse" "json" expr "into" target -> parse_json
json_stringify_stmt: "convert" expr "to" "json" "into" target -> stringify_json
env_var_stmt: "environment" "variable" expr "into" target -> get_env_var
run_cmd_stmt: "run" "command" expr "into" target -> run_cmd
insert_stmt: "insert" expr "at" expr "in" target -> insert_list
sort_stmt: "sort" target "by" NAME [DESCENDING_ORDER] -> sort_records
         | "sort" target DESCENDING_ORDER             -> sort_list_desc
         | "sort" target [ASCENDING_ORDER]            -> sort_list_asc
reverse_stmt: "reverse" target                        -> reverse_list_stmt
group_stmt: "group" expr "by" NAME "into" target -> group_by_stmt
filter_stmt: expr "where" NAME CMP_OP expr "into" target -> filter_records_stmt
comp_assign_stmt: target_list ("is" | "=") ["the"] NAME "of" "each" NAME "in" expr -> comp_assign
dotted_name: (NAME | STRING) ("." (NAME | STRING))* -> dotted_name
import_alias: (NAME | STRING) ["as" NAME] -> import_alias

use_py_stmt: "use" "python" "module" dotted_name ["as" NAME] -> import_module
from_py_stmt: "from" "python" "module" dotted_name "use" import_alias ("," import_alias)* -> import_from_module
use_doom_stmt: "use" expr -> import_doom_file
skip_stmt: "skip" -> skip_stmt

write_file_stmt: "write" expr ("into" | "to") "file" expr -> write_file
append_file_stmt: "append" expr "to" "file" expr -> append_file
read_file_stmt: "read" "file" expr "into" target -> read_file
copy_file_stmt: "copy" "file" expr "to" expr [("with" "overwrite" | "overwrite") expr] -> copy_file
delete_file_stmt: "delete" "file" expr -> delete_file
create_dir_stmt: "create" "directory" expr -> create_dir
list_files_stmt: "list" "files" "in" expr "into" target -> list_files
check_file_stmt: "check" "if" "file" expr "exists" "into" target -> check_file_exists

string_upper_stmt: "convert" expr "to" "uppercase" "into" target -> string_uppercase
string_lower_stmt: "convert" expr "to" "lowercase" "into" target -> string_lowercase

spawn_stmt: "spawn" NAME "with" arg_list "into" target -> spawn_thread_args
          | "spawn" NAME "into" target               -> spawn_thread_noargs
wait_thread_stmt: "wait" "for" atom -> wait_for_thread

route_stmt: "route" NAME expr "to" NAME -> add_route
start_server_stmt: "start" "server" "on" "port" expr "in" "background" "into" target -> start_server_bg
                 | "start" "server" "on" "port" expr -> start_server_fg
stop_server_stmt: "stop" "server" atom -> stop_server

display_colored_stmt: "display" "colored" expr "in" expr -> display_colored
pause_stmt: "pause" ["until" "enter" "pressed"] -> pause_terminal

math_round_stmt: "round" expr "to" expr "decimals" "into" target -> math_round
math_clamp_stmt: "clamp" expr "between" sum_expr "and" sum_expr "into" target -> math_clamp

verify_stmt: "verify" ["that"] expr "otherwise" expr -> verify_assertion

fetch_json_stmt: "fetch" "json" "from" expr "into" target -> fetch_json
fetch_text_stmt: "fetch" "text" "from" expr "into" target -> fetch_text
download_file_stmt: "download" expr ("into" | "to") "file" expr -> download_file

random_roll_stmt: "roll" ("between" | "from") sum_expr ("and" | "to") sum_expr "into" target -> random_range
pick_random_stmt: "pick" "random" "from" expr "into" target -> pick_random
shuffle_stmt: "shuffle" target -> shuffle_list

db_save_stmt: "save" "record" expr "into" "database" expr "table" expr -> db_save
db_load_stmt: "load" "records" "from" "database" expr "table" expr "into" target -> db_load

beep_stmt: "beep" expr ("hz" | "hertz") "for" expr ("seconds" | "second" | "ms" | "milliseconds")? -> beep_action
play_sound_stmt: "play" "sound" expr -> play_sound_action

open_window_stmt: "open_window" expr "with" "width" expr [","] "height" expr -> open_window
draw_circle_stmt: "draw" "circle" "at" expr "," expr "with" "radius" expr [","] "color" expr -> draw_circle
draw_rect_stmt: "draw" "rectangle" "at" expr "," expr "with" "width" expr [","] "height" expr [","] "color" expr -> draw_rect
draw_text_stmt: "draw" "text" expr "at" expr "," expr "with" "size" expr [","] "color" expr -> draw_text
clear_screen_stmt: "clear" "screen" -> clear_screen
refresh_screen_stmt: "refresh" "screen" -> refresh_screen

add_stmt: "add" expr "to" target -> add_to_list
remove_stmt: "remove" expr "from" target -> remove_from_list
wait_stmt: "wait" expr ("seconds" | "second" | "ms" | "milliseconds")? -> wait_seconds
return_stmt: "return" expr? -> return_val
yield_stmt: "yield" expr? -> yield_val
stop_stmt: "stop" -> stop_stmt

call_stmt: "call" NAME [atom] ["with" call_arg_list] -> call_stmt
expr_stmt: call_expr -> expr_stmt
global_stmt: ("global" | "global" "variable" | "modify" "global" | "use" "global") NAME ("," NAME)* -> global_stmt

?compound_stmt: if_stmt
              | unless_stmt
              | with_stmt
              | try_stmt
              | repeat_stmt
              | repeat_range_stmt
              | repeat_while_stmt
              | repeat_until_stmt
              | for_range_stmt
              | for_where_stmt
              | for_stmt
              | while_stmt
              | until_stmt
              | attempt_stmt
              | func_def
              | class_def

with_stmt: "with" expr ["into" target] ":"? _NEWLINE suite -> with_stmt

class_def: "class" NAME ["(" NAME ")"] ":"? _NEWLINE suite -> class_def

if_stmt: "if" expr ":"? _NEWLINE suite elif_clause* else_clause? -> if_stmt
elif_clause: "elif" expr ":"? _NEWLINE suite
else_clause: "else" ":"? _NEWLINE suite

unless_stmt: "unless" expr ":"? _NEWLINE suite else_clause? -> unless_stmt

try_stmt: "try" ":"? _NEWLINE suite "if" "it" "fails" ["as" NAME] ":"? _NEWLINE suite ["always" ":"? _NEWLINE suite] -> try_stmt

repeat_stmt: "repeat" expr ("times" | "time") ":"? _NEWLINE suite -> repeat_stmt
repeat_range_stmt: "repeat" "with" NAME "from" expr "to" expr ["by" expr] ":"? _NEWLINE suite -> repeat_range_stmt
repeat_while_stmt: "repeat" "while" expr ":"? _NEWLINE suite -> repeat_while_stmt
repeat_until_stmt: "repeat" "until" expr ":"? _NEWLINE suite -> repeat_until_stmt
while_stmt: "while" expr ":"? _NEWLINE suite -> repeat_while_stmt
until_stmt: "until" expr ":"? _NEWLINE suite -> repeat_until_stmt
for_target: ident ("," ident)* -> for_target_names
for_range_stmt: "for" ["each"] for_target "from" expr ("to" | "down" "to") expr ["by" expr] [("where" | "if") expr] ":"? _NEWLINE suite -> for_range_stmt
for_where_stmt: "for" ["each"] for_target "in" expr ("where" | "if") expr ":"? _NEWLINE suite -> for_where_stmt
for_stmt: "for" ["each"] for_target "in" expr ":"? _NEWLINE suite -> for_stmt
attempt_stmt: "attempt" ":"? _NEWLINE suite "if" "it" "fails" ":"? _NEWLINE suite -> attempt_stmt
func_def: "to" NAME [NAME ["with" param_list] | "with" param_list] ":"? _NEWLINE suite -> func_def

suite: _INDENT stmt+ _DEDENT

param_item: call_arg_name ["=" atom | atom]
param_list: param_item ("," param_item)*
arg_list: expr ("," expr)*

call_arg_name: ident
call_arg: call_arg_name "=" expr -> kw_call_arg
        | expr                   -> pos_call_arg
call_arg_list: call_arg ("," call_arg)*

?expr: logic_or

?logic_or: logic_or "or" logic_and -> logic_or
         | logic_and

?logic_and: logic_and "and" logic_not -> logic_and
          | logic_not

?logic_not: "not" logic_not -> logic_not
          | compare_expr

?compare_expr: compare_expr IS_EMPTY -> is_empty
             | compare_expr IS_NOT_EMPTY -> is_not_empty
             | compare_expr IS_EVEN -> is_even
             | compare_expr IS_NOT_EVEN -> is_not_even
             | compare_expr IS_ODD -> is_odd
             | compare_expr IS_NOT_ODD -> is_not_odd
             | compare_expr IS_POSITIVE -> is_positive
             | compare_expr IS_NOT_POSITIVE -> is_not_positive
             | compare_expr IS_NEGATIVE -> is_negative
             | compare_expr IS_NOT_NEGATIVE -> is_not_negative
             | compare_expr IS_ZERO -> is_zero
             | compare_expr IS_NOT_ZERO -> is_not_zero
             | compare_expr STARTS_WITH bitwise_or -> str_starts_with
             | compare_expr ENDS_WITH bitwise_or -> str_ends_with
             | compare_expr MATCHES_PATTERN bitwise_or -> str_matches_pattern
             | compare_expr IS_BETWEEN bitwise_or "and" bitwise_or -> is_between
             | compare_expr IS_OUTSIDE bitwise_or "and" bitwise_or -> is_outside
             | compare_expr IS_ONE_OF factor -> is_one_of
             | compare_expr IS_NUMBER -> is_type_number
             | compare_expr IS_NOT_NUMBER -> is_type_not_number
             | compare_expr IS_TEXT -> is_type_text
             | compare_expr IS_NOT_TEXT -> is_type_not_text
             | compare_expr IS_BOOLEAN -> is_type_boolean
             | compare_expr IS_NOT_BOOLEAN -> is_type_not_boolean
             | compare_expr IS_LIST -> is_type_list
             | compare_expr IS_NOT_LIST -> is_type_not_list
             | compare_expr IS_RECORD -> is_type_record
             | compare_expr IS_NOT_RECORD -> is_type_not_record
             | compare_expr "contains" bitwise_or -> contains
             | compare_expr CMP_OP bitwise_or -> compare
             | bitwise_or

IS_EMPTY.4: /\bis\s+empty\b/
IS_NOT_EMPTY.4: /\b(is\s+not|isn't)\s+empty\b/
IS_EVEN.4: /\bis\s+even\b/
IS_NOT_EVEN.4: /\b(is\s+not|isn't)\s+even\b/
IS_ODD.4: /\bis\s+odd\b/
IS_NOT_ODD.4: /\b(is\s+not|isn't)\s+odd\b/
IS_POSITIVE.4: /\bis\s+positive\b/
IS_NOT_POSITIVE.4: /\b(is\s+not|isn't)\s+positive\b/
IS_NEGATIVE.4: /\bis\s+negative\b/
IS_NOT_NEGATIVE.4: /\b(is\s+not|isn't)\s+negative\b/
IS_ZERO.4: /\bis\s+zero\b/
IS_NOT_ZERO.4: /\b(is\s+not\s+zero|isn't\s+zero|is\s+non-?zero)\b/
IS_BETWEEN.4: /\bis\s+between\b/
IS_OUTSIDE.4: /\bis\s+(outside|not\s+between)\b/
IS_ONE_OF.4: /\bis\s+one\s+of\b/
IS_NUMBER.4: /\bis\s+(a\s+)?number\b/
IS_NOT_NUMBER.4: /\b(is\s+not|isn't)\s+(a\s+)?number\b/
IS_TEXT.4: /\bis\s+(text|(a\s+)?string)\b/
IS_NOT_TEXT.4: /\b(is\s+not|isn't)\s+(text|(a\s+)?string)\b/
IS_BOOLEAN.4: /\bis\s+(a\s+)?bool(ean)?\b/
IS_NOT_BOOLEAN.4: /\b(is\s+not|isn't)\s+(a\s+)?bool(ean)?\b/
IS_LIST.4: /\bis\s+(a\s+)?list\b/
IS_NOT_LIST.4: /\b(is\s+not|isn't)\s+(a\s+)?list\b/
IS_RECORD.4: /\bis\s+(a\s+)?(record|dictionary)\b/
IS_NOT_RECORD.4: /\b(is\s+not|isn't)\s+(a\s+)?(record|dictionary)\b/
STARTS_WITH.4: /\bstarts\s+with\b/
ENDS_WITH.4: /\bends\s+with\b/
MATCHES_PATTERN.3: "matches pattern"
DESCENDING_ORDER.3: "descending" | "desc"
ASCENDING_ORDER.3: "ascending" | "asc"

CMP_OP.3: "<="
      | ">="
      | "!="
      | "=="
      | "<"
      | ">"
      | "is at least"      // >=
      | "is at most"       // <=
      | "is greater than"  // >
      | "is over"          // >
      | "is less than"     // <
      | "is under"         // <
      | "is not inside"    // not in
      | "is not in"        // not in
      | "not in"           // not in
      | "is not equal to"  // !=
      | "does not equal"   // !=
      | "is not"           // !=
      | "isn't"            // !=
      | "is equal to"      // ==
      | "equal to"         // ==
      | "is identical to"  // ==
      | "is the same as"   // ==
      | "equals"           // ==
      | "is inside"        // in
      | "is in"            // in
      | "is"               // ==

?bitwise_or: bitwise_or "|" bitwise_xor -> bitor
           | bitwise_xor

?bitwise_xor: bitwise_xor ("^" | "xor") bitwise_and -> bitxor
            | bitwise_and

?bitwise_and: bitwise_and "&" sum_expr -> bitand
            | sum_expr

?sum_expr: sum_expr "+" term -> add
         | sum_expr "-" term -> sub
         | term

?term: term "*" power -> mul
     | term "/" power -> div
     | term "//" power -> floor_div
     | term "%" power -> mod_op
     | term PERCENT_OF factor -> expr_percent_of
     | power

?power: atom "**" power -> pow
      | atom SQUARED -> expr_squared
      | atom CUBED -> expr_cubed
      | atom TO_POWER_OF power -> expr_power_of
      | factor

?factor: "-" factor -> neg
       | file_exists_expr
       | aggregate_expr
       | data_op_expr
       | relative_time_expr
       | count_expr
       | math_fn_expr
       | date_fn_expr
       | atom

data_op_expr: "split" atom ["by" atom]                                 -> expr_split
            | "join" atom ("with" | "by") atom                         -> expr_join
            | "replace" atom "with" atom "in" atom                   -> expr_replace
            | ("trim" | "trimmed") ["of"] atom                           -> expr_trim
            | "uppercase" ["of"] atom                                    -> expr_uppercase
            | "lowercase" ["of"] atom                                    -> expr_lowercase
            | ("capitalize" | "capitalized") ["of"] atom                 -> expr_capitalize
            | SORTED_OF atom                                           -> expr_sorted
            | REVERSED_OF atom                                         -> expr_reversed
            | "copy" "of" atom                                           -> expr_copy
            | UNIQUE_OF atom                                           -> expr_unique
            | ROUND_OF atom "to" atom "decimals"                       -> expr_round_dec
            | ROUND_OF atom                                            -> expr_round
            | atom "as" TYPE_COERCE                                        -> expr_cast

TYPE_COERCE.3: "number" | "text" | "string" | "boolean" | "bool"

file_exists_expr: "file" atom "exists" -> file_exists_factor

aggregate_expr: SUM_OF factor                                      -> agg_sum
              | AVG_OF factor                                      -> agg_avg
              | MEDIAN_OF factor                                   -> agg_median
              | VARIANCE_OF factor                                 -> agg_variance
              | STDEV_OF factor                                    -> agg_stdev
              | PRODUCT_OF factor                                  -> agg_product
              | ("highest" | "maximum") ("in" | "of") factor       -> agg_max
              | ("lowest" | "minimum") ("in" | "of") factor        -> agg_min
              | "first" NUMBER ("items" | "item") ("of" | "in") factor -> slice_first_n
              | "last" NUMBER ("items" | "item") ("of" | "in") factor  -> slice_last_n
              | "first" ["item"] ("of" | "in") factor              -> agg_first
              | "last" ["item"] ("of" | "in") factor               -> agg_last

math_fn_expr: "absolute" "value" "of" factor -> math_abs
            | SQRT_OF factor -> math_sqrt
            | CBRT_OF factor -> math_cbrt

date_fn_expr: "today" -> date_today
            | ("now" | "current" "time") -> date_now

relative_time_expr: atom TIME_UNIT "from" "now" -> time_future
                  | atom TIME_UNIT "ago"        -> time_past

TIME_UNIT: "days" | "day" | "hours" | "hour" | "minutes" | "minute" | "seconds" | "second"

count_expr: COUNT_OF factor -> count_of

call_expr: atom "(" [call_arg_list] ")" -> call_expr

?atom: atom "." NAME -> attr_access
     | atom _POSSESSIVE NAME -> possessive
     | call_expr
     | atom "[" subscript_index "]" -> subscript_expr
     | base_atom

subscript_index: slice_item ("," slice_item)* -> subscript_indices
slice_item: expr ":" [expr] [":" [expr]] -> slice_full
          | ":" [expr] [":" [expr]]      -> slice_lead
          | expr                         -> index_expr

KW_FIRST: "first"
KW_LAST: "last"
KW_LOG: "log"
KW_FILE: "file"

?ident: NAME | KW_FILE | KW_FIRST | KW_LAST | KW_LOG
?base_atom: ident          -> var
          | NUMBER         -> num
          | STRING         -> str
          | "true"         -> const_true
          | "false"        -> const_false
          | "nothing"      -> const_none
          | "none"         -> const_none
          | "null"         -> const_none
          | "nil"          -> const_none
          | list_expr
          | dict_or_set
          | lambda_expr
          | "(" expr ")"
          | "(" "yield" expr? ")" -> yield_expr
          | "(" ")"        -> empty_tuple
          | "(" expr "," [expr ("," expr)*] [","] ")" -> tuple_val

list_expr: "[" [expr ("," expr)* [","]] "]" -> list_val
         | "[" expr comp_clause+ "]"        -> list_comp
         | "[" expr "from" expr "to" expr ["by" expr] "]" -> natural_list_range_comp
         | A_LIST_OF expr comp_clause+ -> natural_list_comp
         | A_LIST_OF expr "from" expr "to" expr ["by" expr] -> natural_list_range_comp
         | A_LIST_OF expr ("," expr)* -> natural_list_val

dict_or_set: "{" [brace_items] "}"          -> dict_or_set_val
           | "{" expr ":" expr comp_clause+ "}" -> dict_comp
           | "{" expr comp_clause+ "}"      -> set_comp

comp_clause: "for" ["each"] for_target "in" expr [("if" | "where") expr] -> comp_clause
           | "for" ["each"] for_target "from" expr "to" expr ["by" expr] [("if" | "where") expr] -> comp_clause_range
lambda_expr: "lambda" [for_target] ":" expr -> lambda_expr
brace_items: brace_item ("," brace_item)* [","]
brace_item: expr ":" expr -> dict_pair
          | expr          -> set_item

?target: ident            -> target_var
       | atom "." NAME    -> target_attr
       | atom _POSSESSIVE NAME   -> target_attr
       | atom "[" subscript_index "]" -> target_subscript

// Lexer & Whitespace rules
_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+
%ignore /[\t \f]+/
%ignore COMMENT
%declare _INDENT _DEDENT

_POSSESSIVE.5: /'s\b|’s\b/
NAME: /[^\W\d]\w*/
COMMENT: /#[^\n]*/
NUMBER: /\d+(\.\d+)?([eE][+-]?\d+)?/
STRING: /"""[\s\S]*?"""|'''[\s\S]*?'''|"([^"\r\n\\]|\\.)*"|'([^'\r\n\\]|\\.)*'/

SORTED_OF.3: /sort(ed)?\s+of/
REVERSED_OF.3: /reverse(d)?\s+(of|in)/
ROUND_OF.3: /round(ed)?\s+of/
UNIQUE_OF.3: /unique(\s+items)?\s+of/
SUM_OF.3: /(sum|total)\s+of/
AVG_OF.3: /(average|mean)\s+of/
COUNT_OF.3: /(count|length)\s+of/
A_LIST_OF.3: /(a\s+)?list\s+of/
PERCENT_OF.3: /(percent|%)\s+of/
SQUARED.3: "squared"
CUBED.3: "cubed"
TO_POWER_OF.3: /(to\s+the\s+power\s+(of\s+)?|raised\s+to\s+)/
SQRT_OF.3: /(square\s+root|sqrt)\s+of/
CBRT_OF.3: /cube\s+root\s+of/
MEDIAN_OF.3: /median\s+of/
VARIANCE_OF.3: /variance\s+of/
STDEV_OF.3: /(standard\s+deviation|stdev)\s+of/
PRODUCT_OF.3: /product\s+of/

