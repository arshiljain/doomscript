# DS-02: Missing Value Imputation
raw_data = [10.0, 20.0, None, 40.0, None, 50.0]
valid_values = [x for x in raw_data if x is not None]
avg_val = mean(valid_values)
imputed = []
for each x in raw_data
    if x is not None
        add x to imputed
    else
        add avg_val to imputed
say "Original:", raw_data
say "Imputed:", imputed

verify that avg_val equals 30.0 otherwise "Mean is 30.0"
verify that imputed[2] equals 30.0 otherwise "Missing at index 2 replaced"
verify that imputed[4] equals 30.0 otherwise "Missing at index 4 replaced"
