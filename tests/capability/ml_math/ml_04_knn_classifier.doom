# ML-04: K-Nearest Neighbors (KNN) Classifier
to distance with p1, p2
    return math.sqrt(sum([(p1[i] - p2[i]) ** 2 for i in range(count of p1)]))

to predict_knn with train_data, point, k
    distances = []
    for each item in train_data
        features, label = item
        d = distance(features, point)
        add (d, label) to distances
    distances.sort(key=a function of pair giving pair[0])
    k_labels = [pair[1] for pair in distances[:k]]
    
    # Majority vote
    votes = {}
    for each lbl in k_labels
        votes[lbl] = votes.get(lbl, 0) + 1
    best_label = max(votes.keys(), key=a function of lbl giving votes[lbl])
    return best_label

# Training data: (features, label)
dataset = [
    ([1.0, 1.0], "Red"),
    ([1.5, 2.0], "Red"),
    ([2.0, 1.0], "Red"),
    ([5.0, 5.0], "Blue"),
    ([6.0, 5.0], "Blue"),
    ([6.0, 6.0], "Blue")
]

p_query = [1.2, 1.3]
pred = predict_knn(dataset, p_query, 3)
say "Prediction for [1.2, 1.3]:", pred

verify that pred is "Red" otherwise "Classified as Red"
