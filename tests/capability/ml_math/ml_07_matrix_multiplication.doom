# ML-07: Matrix Multiplication
to matmul with A, B:
    rows_A = count of A
    cols_A = count of A[0]
    cols_B = count of B[0]
    C = []
    repeat with i from 0 to rows_A - 1:
        row = []
        repeat with j from 0 to cols_B - 1:
            val = sum([A[i][k] * B[k][j] for k in range(cols_A)])
            row.append(val)
        C.append(row)
    return C

A = [
    [1, 2],
    [3, 4]
]
B = [
    [5, 6],
    [7, 8]
]
# C[0][0] = 1*5 + 2*7 = 19
# C[0][1] = 1*6 + 2*8 = 22
# C[1][0] = 3*5 + 4*7 = 43
# C[1][1] = 3*6 + 4*8 = 50
C = matmul(A, B)
say "Result C:", C

verify that C[0][0] is 19 otherwise "C[0][0] is 19"
verify that C[0][1] is 22 otherwise "C[0][1] is 22"
verify that C[1][0] is 43 otherwise "C[1][0] is 43"
verify that C[1][1] is 50 otherwise "C[1][1] is 50"
