# CS2-08: Graph Depth-First Search (DFS)
to dfs with graph, node, visited:
    visited.append(node)
    for each neighbor in graph[node]:
        if neighbor not in visited:
            dfs(graph, neighbor, visited)
    return visited

graph = {
    "A": ["B", "C"],
    "B": ["D", "E"],
    "C": ["F"],
    "D": [],
    "E": ["F"],
    "F": []
}

order = dfs(graph, "A", [])
say "DFS Order from A:", order
verify that order[0] == "A" otherwise "Start is A"
verify that count of order is 6 otherwise "All 6 nodes visited"
