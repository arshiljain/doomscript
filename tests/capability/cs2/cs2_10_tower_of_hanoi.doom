# CS2-10: Tower of Hanoi
to hanoi with n, source, target, auxiliary, moves
    if n is 1
        add source + " -> " + target to moves
        return None
    hanoi(n - 1, source, auxiliary, target, moves)
    add source + " -> " + target to moves
    hanoi(n - 1, auxiliary, target, source, moves)

moves_list = []
hanoi(3, "A", "C", "B", moves_list)
say "Hanoi moves (3 disks):", count of moves_list
for each m in moves_list
    say m

verify that count of moves_list is 7 otherwise "2^3 - 1 = 7 moves"
verify that first item of moves_list is "A -> C" otherwise "First move correct"
verify that last item of moves_list is "A -> C" otherwise "Last move correct"
