# CS2-03: Singly Linked List
define a Node:
    to start with val:
        my val = val
        my next = None

define a LinkedList:
    to start:
        my head = None

    to append with val:
        new_node = Node(val)
        if my head is None:
            my head = new_node
            return None
        cur = my head
        while cur.next is not None:
            cur = cur.next
        cur.next = new_node

    to to_list:
        res = []
        cur = my head
        while cur is not None:
            res.append(cur.val)
            cur = cur.next
        return res

ll = LinkedList()
ll.append(10)
ll.append(20)
ll.append(30)
vals = ll.to_list()
say "Linked List:", vals

verify that vals == [10, 20, 30] otherwise "List values match"
verify that count of vals is 3 otherwise "3 elements in list"
