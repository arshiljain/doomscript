# CS2-06: Tree Traversals (In-order and Pre-order)
define a TNode:
    to start with val, left, right:
        my val = val
        my left = left
        my right = right

to inorder with node, result:
    if node is not None:
        inorder(node.left, result)
        result.append(node.val)
        inorder(node.right, result)
    return result

to preorder with node, result:
    if node is not None:
        result.append(node.val)
        preorder(node.left, result)
        preorder(node.right, result)
    return result

root = TNode(4, TNode(2, TNode(1, None, None), TNode(3, None, None)), TNode(5, None, None))
in_res = inorder(root, [])
pre_res = preorder(root, [])
say "Inorder:", in_res
say "Preorder:", pre_res

verify that in_res == [1, 2, 3, 4, 5] otherwise "Inorder sorted"
verify that pre_res == [4, 2, 1, 3, 5] otherwise "Preorder matches"
