# CS1-01: Bubble Sort
to bubble_sort with items
    n = count of items
    repeat with i from 0 to n - 1
        repeat with j from 0 to n - i - 2
            if items[j] is greater than items[j + 1]
                temp = items[j]
                items[j] = items[j + 1]
                items[j + 1] = temp
    return items

arr = a list of 64, 34, 25, 12, 22, 11, 90
sorted_arr = bubble_sort(arr)
say "Sorted:", sorted_arr
verify that sorted_arr[0] is 11 otherwise "Min should be 11"
verify that sorted_arr[6] is 90 otherwise "Max should be 90"
