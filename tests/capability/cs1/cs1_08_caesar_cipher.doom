# CS1-08: Caesar Cipher
to caesar_encrypt with text, shift:
    result = []
    repeat with i from 0 to (count of text) - 1:
        ch = text[i]
        code = ord(ch)
        if code >= 65 and code <= 90:
            enc = chr((code - 65 + shift) % 26 + 65)
            result.append(enc)
        elif code >= 97 and code <= 122:
            enc = chr((code - 97 + shift) % 26 + 97)
            result.append(enc)
        else:
            result.append(ch)
    return "".join(result)

plain = "Hello, World!"
cipher = caesar_encrypt(plain, 3)
say "Plain:", plain
say "Cipher:", cipher
verify that cipher == "Khoor, Zruog!" otherwise "Expected Khoor, Zruog!"
