# 17_log_file_anomaly_monitor.doom
# Scans log events, tallies severity levels, and assesses alert condition.

set log_entries to [
    "INFO: Gateway initialized",
    "WARN: Connection timeout to redis-01",
    "INFO: User 482 authenticated",
    "ERROR: Failed database transaction 9912",
    "ERROR: Worker pool out of memory",
    "INFO: Heartbeat healthy"
]

set error_count to 0
set warning_count to 0
set info_count to 0

for each entry in log_entries:
    if "ERROR" in entry:
        increase error_count by 1
    else:
        if "WARN" in entry:
            increase warning_count by 1
        else:
            increase info_count by 1

set total_entries to count of log_entries
set error_rate to (error_count / total_entries) * 100.0

say "=== LOG MONITOR TELEMETRY ==="
say "Total Log Events: " + total_entries
say "Errors: " + error_count
say "Warnings: " + warning_count
say "Error Rate: " + error_rate + "%"

if error_rate > 20.0:
    say "INCIDENT: Alert triggered! Error rate exceeds threshold."
else:
    say "System within normal operational boundaries."

verify that error_count == 2 otherwise "Error event count mismatch"
