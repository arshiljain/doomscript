# 10_chemical_reaction_stoichiometry.doom
# Solves stoichiometric balancing and calculates solution concentrations.

domain chem

molecular mass of "C6H12O6" into glucose_molar_mass
molecular mass of "H2O" into water_molar_mass
balance equation "H2 + O2 -> H2O" into balanced_water_rxn

say "=== CHEMISTRY LAB NOTEBOOK ==="
say "Glucose Molar Mass: " + glucose_molar_mass + " g/mol"
say "Water Molar Mass: " + water_molar_mass + " g/mol"
say "Balanced Combustion Reaction: " + balanced_water_rxn

# Calculate solution molarity and pH
molarity of 0.25 moles in 0.50 liters into solution_molarity
say "Prepared Solution Molarity: " + solution_molarity + " mol/L"

pH from hydronium 1.0e-7 into neutral_water_ph
say "Measured Pure Water pH: " + neutral_water_ph

verify that neutral_water_ph == 7.0 otherwise "Neutral pH mismatch"
