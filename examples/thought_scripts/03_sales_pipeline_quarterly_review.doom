# 03_sales_pipeline_quarterly_review.doom
# Evaluates quarterly sales leads, computes conversion rates and metrics.

domain office

set deals to [
    {client: "Acme Corp", amount: 45000, closed: true, rep: "Sarah"},
    {client: "Global Tech", amount: 120000, closed: true, rep: "Sarah"},
    {client: "Omni Industries", amount: 35000, closed: false, rep: "David"},
    {client: "Vertex Systems", amount: 85000, closed: true, rep: "David"},
    {client: "Nova Retail", amount: 60000, closed: true, rep: "Elena"}
]

# Declarative thought aggregations & queries
set total_pipeline_value to sum of amount in deals
set total_closed_value to sum of amount in deals where closed
set closed_deal_count to count of deals where closed
set conversion_rate to closed_deal_count as percent of (count of deals)

say "=== Q3 SALES PIPELINE PERFORMANCE ==="
say "Total Pipeline: {total_pipeline_value as USD}"
say "Total Closed Won: {total_closed_value as USD}"
say "Win Rate: {conversion_rate as percentage}"
say "Closed Deals: {closed_deal_count} of {count of deals}"
